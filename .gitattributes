# 统一 LF：词典/数据文件被 CRLF 污染会让解析出错（tag 尾部混进 \r）
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.csv   text eol=lf
*.tsv   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# 二进制/大文件不做行尾转换
*.png binary
*.jpg binary
*.zip binary
